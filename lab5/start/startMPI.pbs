#!/bin/bash
#PBS -N lab5_mpi_matrix
#PBS -l select=1:ncpus=40:mpiprocs=40
#PBS -l walltime=00:10:00
#PBS -o results/pbs.out
#PBS -e results/pbs.err

cd "$PBS_O_WORKDIR"
if [ ! -f Makefile ]; then
    cd ..
fi

module purge
module load intel/mpi5

make
python3 scripts/generate_matrix.py -n "${MATRIX_SIZE:-2000}" -d data
mpirun -np "${PBS_NP:-40}" ./matrix_mul_mpi_super data/matrix_a.txt data/matrix_b.txt data/result.txt
python3 scripts/verify.py data/matrix_a.txt data/matrix_b.txt data/result.txt
